# --- Nuxt (copy to .env and fill values) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=sb_publishable_YOUR_ANON_OR_PUBLISHABLE_KEY

# Base URL used in client notification emails (e.g. link to /my-requests/:id). No trailing slash.
# Production (Vercel):
NUXT_PUBLIC_SITE_URL=https://eyan-grafix.vercel.app
# Local dev (optional): NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email clients when the owner saves a reply or uploads a layout (server/api/notify/request-response.post.ts).
# RESEND_API_KEY=re_...
# Display name + From address. Quote the whole value if it contains spaces or angle brackets.
# Resend normally requires the address domain to be verified in their dashboard; a random @gmail.com From may be rejected—prefer something like noreply@your-verified-domain.com once DNS is verified.
NUXT_EMAIL_FROM="EyanGraFix <carlian5931@gmail.com>"

# Use Session pooler URI (Dashboard -> Connect -> Session pooler), especially on IPv4-only networks/Vercel.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Dev: fixes "self-signed certificate in certificate chain" when Node does not trust the DB TLS chain (proxy / CA store). Do not use in production unless you understand the risk.
DATABASE_SSL_REJECT_UNAUTHORIZED=false